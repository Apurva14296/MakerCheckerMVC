@model List<MakerCheckerMVC.Models.FileRequest>

<h2>Pending Files</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>File Name</th>
            <th>Type</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.FileName</td>
            <td>@item.FileType</td>
            <td>@item.Status</td>
            <td>
                <a asp-action="Approve"
                   asp-route-id="@item.Id"
                   class="btn btn-success btn-sm">
                    Approve
                </a>

                <a asp-action="Reject"
                   asp-route-id="@item.Id"
                   class="btn btn-danger btn-sm">
                    Reject
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>